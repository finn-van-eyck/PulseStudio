<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Boekingen</h1>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Klant</th>
            <th>Email</th>
            <th>Event</th>
            <th>Totaal</th>
            <th>Datum</th>
            <th>Acties</th>
        </tr>
    </thead>
    <tbody>
        <% bookings.forEach(booking => { %>
        <tr>
            <td><%= booking.id %></td>
            <td><%= booking.customer_name %></td>
            <td><%= booking.customer_email %></td>
            <td><%= booking.event_title %></td>
            <td>€ <%= booking.total_price %></td>
            <td><%= new Date(booking.created_at).toLocaleDateString('nl-BE') %></td>
            <td>
                <a href="/bookings/<%= booking.id %>" class="btn btn-sm btn-warning">Detail</a>
            </td>
        </tr>
        <% }) %>
    </tbody>
</table>