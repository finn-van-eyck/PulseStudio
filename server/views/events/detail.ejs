<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><%= event.title %></h1>
    <a href="/events" class="btn btn-secondary">Terug</a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form action="/events/<%= event.id %>" method="POST" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="mb-3">
                <label class="form-label">Titel</label>
                <input type="text" name="title" class="form-control" value="<%= event.title %>">
            </div>
            <div class="mb-3">
                <label class="form-label">Datum</label>
                <input type="datetime-local" name="date" class="form-control" value="<%= new Date(event.date).toISOString().slice(0,16) %>">
            </div>
            <div class="mb-3">
                <label class="form-label">Locatie</label>
                <select name="location_id" class="form-select">
                    <% locations.forEach(location => { %>
                    <option value="<%= location.id %>" <%= location.id === event.location_id ? 'selected' : '' %>><%= location.name %></option>
                    <% }) %>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Prijs</label>
                <input type="number" name="price" step="0.01" class="form-control" value="<%= event.price %>">
            </div>
            <div class="mb-3">
                <label class="form-label">Thema</label>
                <input type="text" name="theme" class="form-control" value="<%= event.theme %>">
            </div>
            <div class="mb-3">
                <label class="form-label">Afbeelding</label>
                <% if (event.image) { %>
                <img src="<%= event.image %>" class="d-block mb-2" style="max-height: 150px;">
                <% } %>
                <input type="file" name="image" class="form-control" accept="image/*">
            </div>
            <button type="submit" class="btn btn-primary">Opslaan</button>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Zaalplan</h5>
    </div>
    <div class="card-body">
        <div class="d-flex gap-3 mb-3">
            <span><span class="badge bg-success">■</span> Beschikbaar</span>
            <span><span class="badge bg-danger">■</span> Bezet</span>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <% seats.forEach(seat => { %>
            <div class="seat-box <%= seat.is_booked ? 'bg-danger' : 'bg-success' %> text-white rounded d-flex align-items-center justify-content-center"
                style="width: 45px; height: 45px; font-size: 12px; font-weight: bold;">
                <%= seat.label %>
            </div>
            <% }) %>
        </div>
    </div>
</div>