<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><%= event.title %></h1>
  <a href="/events" class="btn btn-secondary">Terug</a>
</div>

<div class="card">
  <div class="card-body">
    <form action="/events/<%= event.id %>" method="POST">
      <div class="mb-3">
        <label class="form-label">Titel</label>
        <input
          type="text"
          name="title"
          class="form-control"
          value="<%= event.title %>"
        />
      </div>
      <div class="mb-3">
        <label class="form-label">Datum</label>
        <input
          type="datetime-local"
          name="date"
          class="form-control"
          value="<%= new Date(event.date).toISOString().slice(0,16) %>"
        />
      </div>
      <div class="mb-3">
        <label class="form-label">Prijs</label>
        <input
          type="number"
          name="price"
          step="0.01"
          class="form-control"
          value="<%= event.price %>"
        />
      </div>
      <div class="mb-3">
        <label class="form-label">Thema</label>
        <input
          type="text"
          name="theme"
          class="form-control"
          value="<%= event.theme %>"
        />
      </div>
      <button type="submit" class="btn btn-primary">Opslaan</button>
    </form>
  </div>
</div>
