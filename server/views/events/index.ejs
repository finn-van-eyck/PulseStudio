<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Events</h1>
    <a href="/events/create" class="btn btn-primary">+ Nieuw event</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Titel</th>
            <th>Datum</th>
            <th>Locatie</th>
            <th>Prijs</th>
            <th>Thema</th>
            <th>Acties</th>
        </tr>
    </thead>
    <tbody>
        <% events.forEach(event => { %>
        <tr>
            <td><%= event.title %></td>
            <td><%= new Date(event.date).toLocaleDateString('nl-BE') %></td>
            <td><%= event.location_name %></td>
            <td>€ <%= event.price %></td>
            <td><%= event.theme %></td>
            <td>
                <a href="/events/<%= event.id %>" class="btn btn-sm btn-warning">Bewerken</a>
            </td>
        </tr>
        <% }) %>
    </tbody>
</table>