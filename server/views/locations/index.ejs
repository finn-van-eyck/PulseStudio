<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Locaties</h1>
    <a href="/locations/create" class="btn btn-primary">+ Nieuwe locatie</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Naam</th>
            <th>Beschrijving</th>
            <th>Capaciteit</th>
            <th>Acties</th>
        </tr>
    </thead>
    <tbody>
        <% locations.forEach(location => { %>
        <tr>
            <td><%= location.name %></td>
            <td><%= location.description %></td>
            <td><%= location.capacity %></td>
            <td>
                <a href="/locations/<%= location.id %>" class="btn btn-sm btn-warning">Bewerken</a>
            </td>
        </tr>
        <% }) %>
    </tbody>
</table>